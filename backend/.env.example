# Server. NODE_ENV must be "development" locally. If it is unset, the app runs as production
# (no insecure fallbacks, dev tools disabled, MongoDB transactions required).
NODE_ENV=development
PORT=5000

# MongoDB - use your own development cluster (e.g. MongoDB Atlas). Never production.
MONGO_URI=mongodb://127.0.0.1:27017/veloop_daily_streak

# JWT - use a long random value (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontend origins (CORS). Required in production, e.g. https://veloop-streak.vercel.app
CLIENT_URL=http://localhost:5173

# "true" (1 hop) or a hop count when running behind a proxy/load balancer (Render, Railway, ...)
TRUST_PROXY=false

# Claims must run in MongoDB transactions. Defaults to true in production (the server refuses to start on a
# standalone MongoDB). Set false ONLY for a local standalone mongod.
# REQUIRE_TRANSACTIONS=false

# QA only: mounts /api/dev/time-travel and /api/dev/reset-my-streak for the calling user.
# Only honoured when NODE_ENV=development/test; always ignored in production.
ENABLE_DEV_TOOLS=false
