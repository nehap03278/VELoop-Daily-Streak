{
  "info": {
    "name": "VELoop Rewards - Daily Streak API",
    "description": "End-to-end and negative tests for the Daily Streak API. Run the whole collection in order (Collection Runner or newman).\n\nPrerequisites: backend running with seeded data (`npm run seed`) and ENABLE_DEV_TOOLS=true. The collection uses the QA-only /api/dev endpoints to reset the demo account and to simulate time passing for that account.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "token2",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "walletBefore",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login (demo user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@veloop.in\",\n  \"password\": \"Demo@1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login (second demo user)",
          "event": [
            {
              "listen": "test",
              "script": {
